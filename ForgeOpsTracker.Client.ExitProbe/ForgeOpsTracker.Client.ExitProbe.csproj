<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A tiny console app the tests run as a separate process (see ExitDrainTests): it captures an
    exception (or traces some work) through the static ForgeOpsTrackerSdk path and ends straight away, the way a cron job
    or a one-off console tool does. Never packed or published.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeOpsTracker.Client\ForgeOpsTracker.Client.csproj" />
  </ItemGroup>

</Project>
